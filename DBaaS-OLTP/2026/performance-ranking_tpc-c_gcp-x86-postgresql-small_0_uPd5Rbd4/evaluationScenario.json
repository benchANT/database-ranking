{
  "metadata": {
    "userId": "benchANT",
    "projectId": "performance-ranking",
    "batchId": "tpc-c",
    "configurationId": "gcp-postgresql-small",
    "executions": 1,
    "executionCounter": 1
  },
  "resourceProvider": {
    "name": "GCP",
    "api": "GCP"
  },
  "dbaasProvider": {
    "name": "GCP",
    "api": "CLOUDSQL"
  },
  "dbmsDeployment": {
    "dbmsType": "POSTGRESQL",
    "operationType": "DBAAS",
    "version": "17",
    "DBAAS": {
      "costs": {
		  "onDemand": 1302
	  },
      "cloudSqlInstance": {
        "edition": "enterprise",
        "region": "europe-west3",
        "cpu": 8,
        "cpuType": "x86",
        "memory": 32,
        "storageSize": 500,
        "storageType": "SSD",
        "dataCache": false,
        "replicaNodes": 0,
        "availabilityType": "regional"
      }
    }
  },
  "benchmarkDeployment": {
    "benchmarkNodes": {
      "numberOfNodes": 1,
      "resource": {
        "gcpVm": {
          "zones": [
            "europe-west3-a"
          ],
          "diskType": "STANDARD",
          "diskSize": 50,
          "machineType": "e2-standard-16",
          "image": "ubuntu-2204-lts"
        }
      }
    }
  },
  "benchmark": {
    "id": "tpc-c",
    "distribution": "BENCHBASETPCC",
